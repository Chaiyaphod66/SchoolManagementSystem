# Copy this file to .env and replace the placeholders.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/Ban_Khlong_Nong_Lek_School?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: set to 1 only while debugging Prisma queries.
DEBUG_PRISMA_QUERY="0"

# Optional: set to 1 only while debugging evaluation calculations.
DEBUG_EVALUATION="0"

# Optional credentials used only by `npm run test:smoke` against a demo database.
SMOKE_DIRECTOR_CODE="D001"
SMOKE_TEACHER_CODE="T001"
SMOKE_STUDENT_CODE="260"
SMOKE_PASSWORD="replace-with-demo-password"
SMOKE_PORT="3217"
